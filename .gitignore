__pycache__/
*.py[cod]
*$py.class
build/
*.spec
*.exe
# Артефакты сборки в КОРНЕ репозитория (build.py собирает с --distpath=..):
# Linux даёт бинарник без расширения «Umbra», macOS — бандл «Umbra.app».
# Без этих правил разработчик на Linux/Mac закоммитил бы ~70 МБ бинарника.
/Umbra
/Umbra.app/
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

.pytest_cache/

dist/

# --- Рабочие артефакты аудита/отладки: могут содержать РЕАЛЬНЫЕ ПДн ---
# Ключи деанонимизации и дампы значений (второй рубеж защиты от утечки).
over_anon_results.json
audit_full.txt
audit_results.json
audit_results.txt
audit_leaks.py
audit_over_anonymization.py
extract_anon_texts.py
batch_anonymize.py
unique_masked.txt
all_anon_texts.txt
runs.json
jobs.json
fetch.py

# Денилист выше ловит артефакты по ТОЧНЫМ именам, поэтому любой НОВЫЙ рабочий
# файл (дамп аудита, черновик, промежуточный вывод агента) с именем вне списка
# в него не попадал: так в дерево уже просочились audit.tmp / context.tmp /
# msg.tmp / hooked_hwnd.txt. Ловим их по расширению — .tmp сюда пишут отладка и
# редиректы PowerShell, а hooked_hwnd.txt — рантайм-артефакт GUI (HWND окна).
*.tmp
hooked_hwnd.txt

# Внутренний контекст для ИИ-агентов: держим ЛОКАЛЬНО (агенты его читают), но НЕ
# публикуем — это рабочие заметки (решения, отклонённые подходы), не продуктовая
# документация. В публичный репозиторий не коммитить.
PROJECT_CONTEXT.md

# Сами обрабатываемые/результирующие документы не должны попадать в репозиторий.
*.docx
*.doc
*.pdf
*.xlsx
*.csv

# Скобки ОБЯЗАНЫ быть экранированы: в gitignore '[' начинает класс символов, и
# незакранированный '*[ANON]*' не ловил ни '[ANON] Договор.md', ни 'Договор
# [ANON].md' — правило было мёртвым, а .md/.txt-артефакты с содержимым дела
# расширениями выше не покрыты. Не «упрощать» обратно.
*\[ANON\]*
*\[UMBRA\]*
*\[ОТВЕТ\]*
*\[DEANON\]*
*.umbra.json

# Исключение: тестовые фикстуры. Данные в них вымышленные, а правила выше
# существуют ради НАСТОЯЩИХ документов дела. Собирать этот PDF в тесте на лету
# нельзя — кириллица требует TTF, которого нет на macOS/Linux-раннерах.
!tests/fixtures/*.pdf
